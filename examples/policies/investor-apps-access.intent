# Block-based Natural policy intent for investor-facing applications.
# Common use case: approved investors may access reporting apps only with MFA
# and low risk; suspicious access pressure is handled by runtime responses.

intent "investor-apps-access"

protect application_group "investor-apps" in "production" as "investor reporting applications"

compose:
  access "investor-apps-access"
  requirements "investor-apps-context"
  detection "investor-apps-runtime-detections"
  response "investor-apps-runtime-responses"
  alert_route "security-ops"
  guardrail "protect-investor-support"
  capabilities "investor-apps-runtime-capabilities"

access "investor-apps-access":
  default deny access to application_group "investor-apps"
  allow role "investors" to access application_group "investor-apps"

requirements "investor-apps-context":
  require "session.authentication.strength" in ["mfa", "phishing_resistant_mfa"]
  require "subject.risk.level" eq "low"
  require "device.posture.status" eq "healthy"
  require "resource.environment" eq "production"

detection "investor-apps-runtime-detections":
  detect "investor-risk-medium":
    when risk equals medium

  detect "investor-risk-high":
    when risk in ["high", "critical"]

  detect "unknown-source-deny-burst":
    when denied access to application_group "investor-apps" by unknown source exceeds 10 within 15m

response "investor-apps-runtime-responses":
  on "investor-risk-medium" then alert route "security-ops" severity "medium" dedupe 15m
  on "investor-risk-high" then deny source for 5m
  on "unknown-source-deny-burst" then rate_limit source for 15m

alert_route "security-ops":
  notify group "security-ops"
  via ["log", "email"]
  dedupe by ["tenant.id", "resource.id", "detection.id", "source.identity_or_ip"]
  create case false
  require acknowledgement within 30m

guardrail "protect-investor-support":
  never auto_block group "investor-support"
  never quarantine group "investor-support"
  never disable identity group "investor-support"

capabilities "investor-apps-runtime-capabilities":
  require identity_based_access
  require context "session.authentication.strength"
  require context "subject.risk.level"
  require context "device.posture.status"
  require context "resource.environment"
  require windowed_detection
  require traffic_rate_limit

gap_handling:
  fail on missing_context
  require_approval on identity_to_ip downgrade
