# Block-based Natural policy intent for privileged admin applications.
# Common use case: restrict admin portals to trusted admins on strong sessions
# and react to risky or suspicious access pressure.

intent "admin-apps-zero-trust"

protect application_group "admin-apps" in "production" as "privileged administration apps"

compose:
  access "admin-apps-access"
  requirements "admin-apps-context"
  detection "admin-apps-runtime-detections"
  response "admin-apps-runtime-responses"
  alert_route "security-ops"
  guardrail "protect-breakglass-admins"
  capabilities "admin-apps-runtime-capabilities"

access "admin-apps-access":
  default deny access to application_group "admin-apps"
  allow group "company-admins" to access application_group "admin-apps"

requirements "admin-apps-context":
  require "session.authentication.strength" eq "phishing_resistant_mfa"
  require "subject.risk.level" eq "low"
  require "device.management.status" eq "managed"
  require "device.posture.status" eq "healthy"
  require "session.network_zone" in ["vpn", "zero_trust_overlay"]

detection "admin-apps-runtime-detections":
  detect "admin-risk-medium":
    when "runtime.risk.level" equals medium

  detect "admin-risk-high":
    when "runtime.risk.level" in ["high", "critical"]

  detect "non-admin-deny-burst":
    when denied access to application_group "admin-apps" by known subject excluding group "company-admins" exceeds 5 within 15m

  detect "unknown-source-deny-burst":
    when denied access to application_group "admin-apps" by unknown source exceeds 20 within 15m

  detect "sustained-admin-pressure":
    when rate_limit drops to application_group "admin-apps" by unknown source sustained for 5m

response "admin-apps-runtime-responses":
  on "admin-risk-medium" then alert route "security-ops" severity "medium" dedupe 15m
  on "admin-risk-medium" then rate_limit source for 15m
  on "admin-risk-high" then rate_limit source for 5m
  on "unknown-source-deny-burst" then rate_limit source for 10m
  on "sustained-admin-pressure" then temporary_block source for 10m
    require previous action "enforce.traffic.rate_limit" active
    allow local enforcement state evidence
    require enforcement target excludes group "breakglass-admins"

alert_route "security-ops":
  notify group "security-ops"
  via ["log", "email"]
  dedupe by ["tenant.id", "resource.id", "detection.id", "source.identity_or_ip"]
  create case false
  require acknowledgement within 30m
  escalate if unacknowledged to group "security-oncall"

guardrail "protect-breakglass-admins":
  never auto_block group "breakglass-admins"
  never quarantine group "breakglass-admins"
  never disable identity group "breakglass-admins"

capabilities "admin-apps-runtime-capabilities":
  require context "session.authentication.strength"
  require context "subject.risk.level"
  require context "device.management.status"
  require context "device.posture.status"
  require context "session.network_zone"
  require windowed_detection
  require traffic_rate_limit
  require temporary_traffic_block

gap_handling:
  fail on missing_context
  require_approval on identity_to_ip downgrade
