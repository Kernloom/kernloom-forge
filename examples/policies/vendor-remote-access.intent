# Block-based Natural policy intent for third-party/vendor remote access.
# Common use case: allow approved partners into a partner-facing app only
# through the zero-trust overlay and react quickly to suspicious pressure.

intent "vendor-remote-access"

protect application_group "vendor-portal" in "production" as "partner and vendor portal"

compose:
  access "vendor-remote-access"
  requirements "vendor-remote-context"
  detection "vendor-remote-runtime-detections"
  response "vendor-remote-runtime-responses"
  alert_route "security-ops"
  guardrail "protect-vendor-approvers"
  capabilities "vendor-remote-runtime-capabilities"

access "vendor-remote-access":
  default deny access to application_group "vendor-portal"
  allow external_partner "approved-vendors" to access application_group "vendor-portal"

requirements "vendor-remote-context":
  require "subject.risk.level" eq "low"
  require "session.authentication.strength" in ["mfa", "phishing_resistant_mfa"]
  require "session.network_zone" eq "zero_trust_overlay"
  require "resource.exposure" eq "partner"

detection "vendor-remote-runtime-detections":
  detect "vendor-risk-medium":
    when "runtime.risk.level" equals medium

  detect "vendor-risk-high":
    when "runtime.risk.level" in ["high", "critical"]

  detect "unknown-source-deny-burst":
    when denied access to application_group "vendor-portal" by unknown source exceeds 10 within 15m

  detect "scan-suspected":
    when signal "source.scan_suspected" score gte 0.8

  detect "sustained-vendor-pressure":
    when rate_limit drops to application_group "vendor-portal" by unknown source sustained for 5m

response "vendor-remote-runtime-responses":
  on "vendor-risk-medium" then alert route "security-ops" severity "medium" dedupe 15m
  on "vendor-risk-high" then rate_limit source for 5m
  on "scan-suspected" then rate_limit source for 15m
  on "unknown-source-deny-burst" then rate_limit source for 10m
  on "sustained-vendor-pressure" then temporary_block source for 10m
    require previous action "enforce.traffic.rate_limit" active
    allow local enforcement state evidence
    require enforcement target excludes group "vendor-approvers"

alert_route "security-ops":
  notify group "security-ops"
  via ["log", "email"]
  dedupe by ["tenant.id", "resource.id", "detection.id", "source.identity_or_ip"]
  create case false
  require acknowledgement within 30m

guardrail "protect-vendor-approvers":
  never auto_block group "vendor-approvers"
  never quarantine group "vendor-approvers"
  never disable identity group "vendor-approvers"

capabilities "vendor-remote-runtime-capabilities":
  require context "subject.risk.level"
  require context "session.authentication.strength"
  require context "session.network_zone"
  require context "resource.exposure"
  require windowed_detection
  require traffic_rate_limit
  require temporary_traffic_block

gap_handling:
  fail on missing_context
  require_approval on identity_to_ip downgrade
